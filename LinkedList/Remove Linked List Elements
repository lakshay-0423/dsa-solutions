// Problem: Remove Linked List Elements
// Link: https://leetcode.com/problems/remove-linked-list-elements/
// Difficulty: Easy
// Approach: Dummy head + two pointers - skip nodes matching val by relinking prev to next
// Time: O(n) | Space: O(1)

class Solution {
    public ListNode removeElements(ListNode head, int val) {
        if(head==null) return null;
        ListNode dummy=new ListNode(-1);
        dummy.next=head;
        ListNode temp=head;
        ListNode prev=dummy;
        while(temp!=null){
            if(temp.val==val){
                prev.next=prev.next.next;
                temp=temp.next;
                continue;
            }
            prev=temp;
            temp=temp.next;
        }
        return dummy.next;
    }
}